---
import { Icon } from 'astro-icon/components'

console.log('Contact form!')
---

<script>
  import { submitForm } from '@/utils/contactForm'

  const form: HTMLFormElement | null =
    document.querySelector('#contactform-form')

  form?.addEventListener('submit', (event) => {
    event.preventDefault()
    submitForm()
  })
</script>
<dialog
  id="contactform"
  class="w-full max-w-md rounded-xl border-none p-0 shadow-xl"
>
  <div class="flex justify-between bg-theme p-4 text-white">
    <span>Send me a message</span>
    <button
      type="button"
      class="cursor-pointer [all:unset]"
      command="close"
      commandfor="contactform"
    >
      <Icon
        name="codicon:close-small"
        class="size-6.25 cursor-pointer text-white"
      />
    </button>
  </div>
  <form id="contactform-form" method="dialog" class="p-4">
    <label class="block" for="contactform-name">
      Name
    </label>
    <input
      type="text"
      class="mb-3.75 min-h-6.25 w-full rounded-sm border border-[#d3d3d3]"
      id="contactform-name"
      name="name"
      required
      minlength="2"
      maxlength="50"
    />
    <label class="block" for="contactform-email">
      Email
    </label>
    <input
      type="email"
      class="mb-3.75 min-h-6.25 w-full rounded-sm border border-[#d3d3d3]"
      id="contactform-email"
      name="email"
      required
      minlength="2"
      maxlength="50"
    />
    <label class="block" for="contactform-message">
      Message
    </label>
    <textarea
      class="min-h-50 w-full resize-none rounded-sm border border-[#d3d3d3]"
      id="contactform-message"
      name="message"
      required
      minlength="3"
      maxlength="500"
    ></textarea>
    <div class="mt-3.75 flex justify-center gap-2.5">
      <button
        type="submit"
        class="cursor-pointer rounded-sm border-0 px-3.75 py-2.5 bg-[#3182ce] text-white"
      >
        Submit
      </button>
      <button
        type="button"
        class="cursor-pointer rounded-sm border-0 px-3.75 py-2.5"
        command="close"
        commandfor="contactform"
      >
        Close
      </button>
    </div>
  </form>
</dialog>
