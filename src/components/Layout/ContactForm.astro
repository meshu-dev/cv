---
import { Icon } from 'astro-icon/components'

const field =
  'w-full rounded-md border border-rule bg-white px-3 py-2 font-serif text-base text-ink transition-colors outline-none focus:border-accent focus:ring-3 focus:ring-accent-soft'
---

<script>
  import { submitForm } from '@/utils/contactForm'

  const form: HTMLFormElement | null =
    document.querySelector('#contactform-form')

  form?.addEventListener('submit', (event) => {
    event.preventDefault()
    submitForm()
  })
</script>
<dialog
  id="contactform"
  aria-labelledby="contactform-title"
  class="no-print m-auto w-[min(30rem,calc(100%-2rem))] rounded-lg bg-paper p-0 text-ink shadow-2xl backdrop:bg-ink/60"
>
  <div class="flex items-center justify-between border-b border-rule px-5 py-4">
    <h2 id="contactform-title" class="font-sans text-lg font-semibold">
      Send me a message
    </h2>
    <button
      type="button"
      aria-label="Close"
      class="grid size-8 cursor-pointer place-items-center rounded-md text-ink-soft hover:bg-white hover:text-ink"
      command="close"
      commandfor="contactform"
    >
      <Icon name="codicon:close" class="size-5" aria-hidden="true" />
    </button>
  </div>
  <form
    id="contactform-form"
    method="dialog"
    class="grid gap-4 px-5 pt-4 pb-5 font-sans text-[0.9375rem]"
  >
    <div class="grid gap-1.5">
      <label class="font-medium" for="contactform-name">
        Name
      </label>
      <input
        type="text"
        class={field}
        id="contactform-name"
        name="name"
        autocomplete="name"
        required
        minlength="2"
        maxlength="50"
      />
    </div>
    <div class="grid gap-1.5">
      <label class="font-medium" for="contactform-email">
        Email
      </label>
      <input
        type="email"
        class={field}
        id="contactform-email"
        name="email"
        autocomplete="email"
        required
        minlength="2"
        maxlength="50"
      />
    </div>
    <div class="grid gap-1.5">
      <label class="font-medium" for="contactform-message">
        Message
      </label>
      <textarea
        class:list={[field, 'min-h-40 resize-y']}
        id="contactform-message"
        name="message"
        required
        minlength="3"
        maxlength="500"
      ></textarea>
    </div>
    <div class="mt-1 flex flex-row-reverse justify-start gap-2">
      <button
        type="submit"
        class="cursor-pointer rounded-md bg-accent px-4 py-2 font-medium text-white transition-colors hover:bg-ink"
      >
        Send message
      </button>
      <button
        type="button"
        class="cursor-pointer rounded-md px-4 py-2 font-medium text-ink-soft hover:bg-white hover:text-ink"
        command="close"
        commandfor="contactform"
      >
        Cancel
      </button>
    </div>
  </form>
</dialog>
