import { showToast } from "@/services/toast"

const form: HTMLFormElement | null = document.querySelector("#contactform-form")

async function sendData() {
    if (form) {
        const token: string = import.meta.env.PUBLIC_GOOGLE_RECAPTCHA_KEY as string
        const formData = new FormData(form)

        console.log('formData', Object.fromEntries(formData), form, formData.values(), formData.get('name'))

        showToast('Bing!');

        try {
            const response = await PortfolioApiService.sendMessage(
                token,
                formData.get('name') as string,
                formData.get('email') as string,
                formData.get('message') as string
            )

            if (response.success) {
                let toastMessage = 'Message sent! You will receive a reply shortly'
                let toastStatus: string = 'success'
                //closeForm()
            } else if (response.message) {
                //toastMessage = response.message
            }
        } catch (e) {

        }



