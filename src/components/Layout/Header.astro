---
import { Icon } from 'astro-icon/components'

const { pdfUrl } = Astro.props
const googleKey: string | null = import.meta.env
  .PUBLIC_GOOGLE_RECAPTCHA_KEY as string
---

<>
  <a
    href="#body-wrapper"
    class="sr-only bg-ink px-4 py-2 font-sans font-semibold text-white focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded"
  >
    Skip to content
  </a>
  <header class="no-print border-b border-rule">
    <div class="mx-auto flex h-16 max-w-page items-center justify-between gap-4 px-5 font-sans sm:px-8">
      <p class="text-lg font-semibold tracking-tight">Mesh&apos;s CV</p>
      <div class="flex items-center gap-1 text-[0.9375rem] font-medium">
        {pdfUrl ? (
          <a
            href={pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-ink-soft transition-colors hover:bg-white hover:text-ink"
            data-testid="pdf-link"
          >
            <Icon
              name="codicon:cloud-download"
              class="size-4"
              aria-hidden="true"
            />
            Download PDF
          </a>
        ) : null}
        {googleKey ? (
          <button
            type="button"
            class="cursor-pointer rounded-md bg-ink px-3 py-1.5 text-white transition-colors hover:bg-accent"
            command="show-modal"
            commandfor="contactform"
          >
            Contact me
          </button>
        ) : null}
      </div>
    </div>
  </header>
</>
