---
const { pdfUrl } = Astro.props
const googleKey: string | null = import.meta.env
  .PUBLIC_GOOGLE_RECAPTCHA_KEY as string

console.log('Google Key', googleKey)
---

<>
  <a href="#body-wrapper" class="skip-link">
    Skip to content
  </a>
  <header>
    <div id="header-wrapper">
      <div id="header-logo">Mesh&apos;s CV</div>
      <div id="header-links">
        {pdfUrl ? (
          <a
            href={pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="header-link"
            data-testid="pdf-link"
          >
            Download
          </a>
        ) : null}
        {googleKey ? (
          <button
            class="header-link"
            command="show-modal"
            commandfor="contactform"
          >
            Contact
          </button>
        ) : null}
      </div>
    </div>
  </header>
</>
