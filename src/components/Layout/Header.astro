---
const { pdfUrl } = Astro.props
const googleKey: string | null = import.meta.env
  .PUBLIC_GOOGLE_RECAPTCHA_KEY as string

console.log('Google Key', googleKey)
---

<>
  <a
    href="#body-wrapper"
    class="sr-only bg-theme px-4 py-2 font-bold text-white no-underline focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded"
  >
    Skip to content
  </a>
  <header class="min-h-12.5 pt-2.5 bg-theme text-white">
    <div class="mx-auto flex max-w-page items-center justify-between px-5">
      <div class="text-3xl">Mesh&apos;s CV</div>
      <div>
        {pdfUrl ? (
          <a
            href={pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-white p-1.25 mx-1.25 no-underline hover:bg-gray-200 hover:text-black hover:rounded-sm hover:cursor-pointer"
            data-testid="pdf-link"
          >
            Download
          </a>
        ) : null}
        {googleKey ? (
          <button
            class="text-white p-1.25 mx-1.25 no-underline hover:bg-gray-200 hover:text-black hover:rounded-sm hover:cursor-pointer [font:inherit] border-0 bg-transparent cursor-pointer"
            command="show-modal"
            commandfor="contactform"
          >
            Contact
          </button>
        ) : null}
      </div>
    </div>
  </header>
</>
