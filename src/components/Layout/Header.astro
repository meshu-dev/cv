---
const { pdfUrl } = Astro.props
const googleKey: string|null = null
---
<>
  <a href="#body-wrapper" class="skip-link">
    Skip to content
  </a>
  <header>
    <div id="header-wrapper">
      <div id="header-logo">Mesh&apos;s CV</div>
      <div id="header-links">
        {pdfUrl ? (
          <a
            href={pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="header-link"
            data-testid="pdf-link"
          >
            Download
          </a>
        ) : null}
        {googleKey ? (
          <button
            type="button"
            class="header-link"
            onClick="null"
            data-testid="contact-button"
          >
            Contact
          </button>
        ) : null}
      </div>
    </div>
  </header>
</>