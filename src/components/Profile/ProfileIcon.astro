---
import type { ProfileSite } from '@/types'
import { Icon } from 'astro-icon/components'

interface Props {
  profileSite: ProfileSite
}

const { profileSite } = Astro.props
---

<a
  href={profileSite.url}
  target="_blank"
  rel="noopener noreferrer"
  title={profileSite.name}
  aria-label={profileSite.name}
  class="no-underline"
>
  <Icon name={profileSite.icon} class="size-6.25 text-black" />
</a>
