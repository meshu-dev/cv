---
import type { ProfileSite } from '@/types'
import { Icon } from 'astro-icon/components'

interface Props {
  profileSite: ProfileSite
}

const { profileSite } = Astro.props
---

<a
  href={profileSite.url}
  target="_blank"
  rel="noopener noreferrer"
  title={profileSite.name}
  aria-label={profileSite.name}
  class="no-print grid size-10 place-items-center rounded-md text-ink transition-colors hover:bg-white hover:text-accent"
>
  <Icon name={profileSite.icon} class="size-5.5" aria-hidden="true" />
</a>
