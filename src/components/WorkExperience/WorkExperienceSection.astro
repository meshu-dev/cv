---
import WorkExperienceEntry from '@/components/WorkExperience/WorkExperienceEntry.astro'
import type { WorkExperience } from '@/types'

interface Props {
  workExperiences: WorkExperience[]
}

const { workExperiences } = Astro.props
---

{workExperiences.length > 0 ? (
  <section class="border-t border-ink pt-6">
    <h2 class="font-sans text-2xl font-semibold tracking-tight">
      Work experience
    </h2>
    <ol class="mt-2">
      {workExperiences.map((workExperience) => (
        <WorkExperienceEntry workExperience={workExperience} />
      ))}
    </ol>
  </section>
) : null}
