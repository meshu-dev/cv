---
import type { WorkExperience } from '@/types'
import dayjs from 'dayjs'

interface Props {
  workExperience: WorkExperience
}

const { workExperience } = Astro.props
---

<div class="workexp-entry mb-5 border-b border-[#ccc] pb-5 last:border-b-0">
  <div class="workexp-entry-header mb-5 flex justify-between">
    <h3 class="workexp-entry-title m-0 text-[22px]">{workExperience.title}</h3>
    <div class="workexp-entry-datelocation h-[25px] rounded bg-[#a1a1a1] px-2.5 py-[5px] font-bold text-white max-[800px]:h-[52px] max-[800px]:min-w-[160px] max-[800px]:text-center">
      <span class="workexp-entry-location inline-block text-center after:content-['_|'] max-[800px]:block max-[800px]:after:content-['']">
        {workExperience.location}
      </span>
      &nbsp;
      <span>
        {dayjs(workExperience.start_date).format('MMM YY')}&nbsp;-&nbsp;
        {workExperience.end_date
          ? dayjs(workExperience.end_date).format('MMM YY')
          : 'Present'}
      </span>
    </div>
  </div>
  <div class="workexp-entry-info">{workExperience.description}</div>
  <div class="workexp-entry-tasks mt-5 ml-10 max-[800px]:ml-5">
    <ul>
      {workExperience.responsibilities?.map((responsibility) => (
        <li class="mb-2.5">{responsibility}</li>
      ))}
    </ul>
  </div>
</div>
