---
import type { WorkExperience } from '@/types'
import dayjs from 'dayjs'

interface Props {
  workExperience: WorkExperience
}

const { workExperience } = Astro.props
---

<div class="workexp-entry mb-5 border-b border-[#ccc] pb-5 last:border-b-0">
  <div class="mb-5 flex justify-between">
    <h3 class="m-0 text-xl">{workExperience.title}</h3>
    <div class="flex shrink-0 flex-col items-start self-start rounded bg-slate-700 px-3 py-1.5 text-sm leading-snug text-white max-md:min-w-40 max-md:items-start">
      <span class="font-semibold">{workExperience.location}</span>
      <span class="text-slate-200">
        {dayjs(workExperience.start_date).format('MMM YY')}&nbsp;-&nbsp;
        {workExperience.end_date
          ? dayjs(workExperience.end_date).format('MMM YY')
          : 'Present'}
      </span>
    </div>
  </div>
  <div class="">{workExperience.description}</div>
  <div class="mt-5 ml-10 max-md:ml-5">
    <ul>
      {workExperience.responsibilities?.map((responsibility) => (
        <li class="mb-2.5">{responsibility}</li>
      ))}
    </ul>
  </div>
</div>
