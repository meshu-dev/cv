---
import type { WorkExperience } from '@/types'
import dayjs from 'dayjs'

interface Props {
  workExperience: WorkExperience
}

const { workExperience } = Astro.props

const isCurrent = !workExperience.end_date
const start = dayjs(workExperience.start_date)
const end = isCurrent ? null : dayjs(workExperience.end_date)
---

<li class="workexp-entry avoid-break grid gap-x-10 gap-y-3 border-b border-rule py-8 last:border-b-0 sm:grid-cols-[10.5rem_1fr]">
  <div class="font-sans text-[0.9375rem] leading-snug tabular-nums">
    <p class:list={['font-medium', isCurrent ? 'text-accent' : 'text-ink']}>
      <span class="whitespace-nowrap">
        <time datetime={start.format('YYYY-MM')}>
          {start.format('MMM YYYY')}
        </time>
        {' –'}
      </span>{' '}
      <span class="whitespace-nowrap">
        {end ? (
          <time datetime={end.format('YYYY-MM')}>{end.format('MMM YYYY')}</time>
        ) : (
          'Present'
        )}
      </span>
    </p>
    <p class="mt-0.5 text-ink-soft">{workExperience.location}</p>
  </div>
  <div>
    <h3 class="font-sans text-xl leading-snug font-semibold tracking-tight">
      {workExperience.title}
    </h3>
    {workExperience.description && (
      <p class="mt-2 text-ink-soft">{workExperience.description}</p>
    )}
    {workExperience.responsibilities?.length ? (
      <ul class="mt-4 grid list-disc gap-2 pl-5 marker:text-accent">
        {workExperience.responsibilities.map((responsibility) => (
          <li class="pl-1">{responsibility}</li>
        ))}
      </ul>
    ) : null}
  </div>
</li>
