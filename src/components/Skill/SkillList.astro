---
import type { Skill } from '@/types'

interface Props {
  skill: Skill
}

const { skill } = Astro.props
---

<div class="skills-section max-w-[200px] min-w-[180px] flex-1">
  <h3>{skill.name}</h3>
  <ul>
    {skill.technologies?.map((name) => (
      <li class="mb-[5px]">{name}</li>
    ))}
  </ul>
</div>
