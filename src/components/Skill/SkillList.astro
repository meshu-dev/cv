---
import type { Skill } from '@/types'

interface Props {
  skill: Skill
}

const { skill } = Astro.props
---

<div class="skills-section avoid-break grid items-baseline gap-x-10 gap-y-1 sm:grid-cols-[10.5rem_1fr]">
  <h3 class="font-sans text-base font-semibold">{skill.name}</h3>
  <ul class="text-ink-soft">
    {skill.technologies?.map((name) => (
      <li class="inline after:content-[',_'] last:after:content-none">
        {name}
      </li>
    ))}
  </ul>
</div>
