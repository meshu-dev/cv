---
import type { Skill } from '@/types'

interface Props {
  skill: Skill
}

const { skill } = Astro.props
---

<div class="skills-section max-w-50 min-w-45 flex-1">
  <h3>{skill.name}</h3>
  <ul>
    {skill.technologies?.map((name) => (
      <li class="mb-1.25">{name}</li>
    ))}
  </ul>
</div>
