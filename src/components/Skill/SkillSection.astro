---
import SkillList from '@/components/Skill/SkillList.astro'
import type { Skill } from '@/types'

interface Props {
  skills: Skill[]
}

const { skills } = Astro.props
---

{skills.length > 0 ? (
  <section class="mt-20">
    <h2 class="mb-2.5 border-b border-[#ccc] pb-2.5 text-3xl">Skills</h2>
    <div class="flex flex-row flex-nowrap justify-between max-md:flex-wrap">
      {skills.map((skill) => (
        <SkillList skill={skill} />
      ))}
    </div>
  </section>
) : null}
