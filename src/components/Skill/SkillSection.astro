---
import SkillList from '@/components/Skill/SkillList.astro'
import type { Skill } from '@/types'

interface Props {
  skills: Skill[]
}

const { skills } = Astro.props
---

{skills.length > 0 ? (
  <section class="border-t border-ink pt-6 pb-14 sm:pb-20">
    <h2 class="font-sans text-2xl font-semibold tracking-tight">Skills</h2>
    <div class="mt-6 grid gap-4">
      {skills.map((skill) => (
        <SkillList skill={skill} />
      ))}
    </div>
  </section>
) : null}
