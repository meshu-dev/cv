---
import ContactForm from '@/components/Layout/ContactForm.astro'
import Header from '@/components/Layout/Header.astro'
import Toast from '@/components/Layout/Toast.astro'
import ProfileSection from '@/components/Profile/ProfileSection.astro'
import SkillSection from '@/components/Skill/SkillSection.astro'
import WorkExperienceSection from '@/components/WorkExperience/WorkExperienceSection.astro'
import { login, getData } from '@/utils/portfolioApi'
import type { Auth, CV } from '@/types'
import '@/styles/global.css'

type Props = {
  cv: CV | null
}

const userEmail: string = import.meta.env.PORTFOLIO_API_EMAIL as string
const userPassword: string = import.meta.env.PORTFOLIO_API_PASSWORD as string

let cv: CV | null = null

try {
  const auth: Auth | null = await login(userEmail, userPassword)

  if (auth?.token) {
    cv = await getData(auth.token)

    console.log('cv', cv)
  }
} catch (e) {
  console.error('Failed to fetch CV data:', e)
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{cv?.profile?.fullname ? `${cv.profile.fullname} | CV` : 'CV'}</title>
    {cv?.profile?.intro && (
      <meta name="description" content={cv.profile.intro} />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..600;1,8..60,400&display=swap"
    />
  </head>
  <body>
    <Header pdfUrl={cv?.pdf || null} />
    <main id="body-wrapper" class="mx-auto max-w-page px-5 pb-24 sm:px-8">
      {!cv ? (
        <p class="py-24 text-ink-soft">
          The CV can't be shown right now. Try again in a few minutes.
        </p>
      ) : (
        <>
          {cv.profile && <ProfileSection profile={cv.profile} />}
          {cv.skills && <SkillSection skills={cv.skills} />}
          {cv.work_experiences && (
            <WorkExperienceSection workExperiences={cv.work_experiences} />
          )}
        </>
      )}
    </main>
    <ContactForm />
    <Toast />
  </body>
</html>
